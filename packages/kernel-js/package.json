  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./wasm/reflex_wasm_bg.wasm": "./wasm/reflex_wasm_bg.wasm"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wasm/reflex_wasm.js",
    "wasm/reflex_wasm.d.ts",
    "wasm/reflex_wasm_bg.wasm",
    "wasm/reflex_wasm_bg.wasm.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ozoneRatchapon/reflexwork.git",
    "directory": "packages/kernel-js"
  },
  "homepage": "https://reflexwork.pages.dev",
  "publishConfig": {
    "access": "public"
  }
}
